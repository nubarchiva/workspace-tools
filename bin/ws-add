#!/bin/bash
# Añade uno o más repos a un workspace existente
# Soporta repos en subdirectorios (ej: libs/marc4j, modules/docs, tools/*)

# Inicializacion centralizada
source "$(dirname "${BASH_SOURCE[0]:-$0}")/ws-init.sh"

# Determinar workspace y repos
# Prioridad: 1) Workspace explícito si $1 coincide con uno existente
#            2) Auto-detección si estamos dentro de un workspace
#            3) Modo tradicional (primer arg es workspace)
WORKSPACE_PATTERN=""
REPOS=()

if [ -n "$1" ]; then
    # Verificar si primer argumento corresponde a un workspace existente
    first_arg_lower=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    is_workspace=false

    if [ -d "$WORKSPACES_DIR" ]; then
        for ws_dir in "$WORKSPACES_DIR"/*; do
            if [ -d "$ws_dir" ]; then
                ws_name=$(basename "$ws_dir")
                ws_name_lower=$(echo "$ws_name" | tr '[:upper:]' '[:lower:]')
                if [[ "$ws_name_lower" == *"$first_arg_lower"* ]]; then
                    is_workspace=true
                    break
                fi
            fi
        done
    fi

    if [ "$is_workspace" = true ]; then
        # Primer argumento coincide con workspace → modo explícito
        WORKSPACE_PATTERN="$1"
        shift
        REPOS=("$@")
    else
        # Primer argumento NO es workspace → intentar auto-detección
        DETECTED_WORKSPACE=$(detect_current_workspace 2>/dev/null || true)
        if [ -n "$DETECTED_WORKSPACE" ]; then
            # Auto-detectado, todos los args son repos
            WORKSPACE_PATTERN="$DETECTED_WORKSPACE"
            REPOS=("$@")
        else
            # No auto-detectado, asumir modo tradicional
            WORKSPACE_PATTERN="$1"
            shift
            REPOS=("$@")
        fi
    fi
else
    # Sin argumentos, intentar auto-detección
    DETECTED_WORKSPACE=$(detect_current_workspace 2>/dev/null || true)
    if [ -n "$DETECTED_WORKSPACE" ]; then
        WORKSPACE_PATTERN="$DETECTED_WORKSPACE"
        # Si primer argumento está vacío, saltarlo
        if [ "$#" -gt 0 ] && [ -z "$1" ]; then
            shift
        fi
        REPOS=("$@")
    fi
fi

if [ ${#REPOS[@]} -eq 0 ]; then
    echo "Uso: ws add <nombre|patrón> <repo1> [repo2] [repo3] ..."
    echo ""
    echo "Repos:"
    echo "  Especifica repos con su ruta relativa desde $WORKSPACE_ROOT"
    echo "  Ejemplos: ks-nuba, libs/marc4j, modules/docs, tools/otro-tool"
    echo ""
    echo "💡 Puedes usar coincidencia parcial para el nombre del workspace"
    echo "💡 Puedes añadir múltiples repos a la vez"
    echo ""
    echo "Ejemplos:"
    echo "  ws add nuba-8400 ks-nuba"
    echo "  ws add nuba-8400 ks-nuba dga-commons libs/marc4j    # múltiples repos"
    echo "  ws add fac libs/marc4j              # búsqueda parcial"
    echo "  ws add master libs/dspace"
    echo "  ws add develop modules/metadata-entities"
    exit 1
fi

# Buscar workspace que coincida con el patrón
WORKSPACE_NAME=$(find_matching_workspace "$WORKSPACE_PATTERN" "$WORKSPACES_DIR")
if [ $? -ne 0 ]; then
    exit 1
fi

# Determinar directorio y branch del workspace
WORKSPACE_DIR="$WORKSPACES_DIR/$WORKSPACE_NAME"
BRANCH_NAME="$(get_branch_name "$WORKSPACE_NAME")"

if [ ! -d "$WORKSPACE_DIR" ]; then
    error "❌ Workspace no existe: $WORKSPACE_NAME"
    info "💡 Créalo primero con: ws new $WORKSPACE_NAME"
    exit 1
fi

# Procesar cada repo
MAVEN_ISOLATED=0
for REPO in "${REPOS[@]}"; do
    # El repo puede estar en subdirectorio (ej: libs/marc4j, tools/workspace-tools)
    REPO_PATH="$WORKSPACE_ROOT/$REPO"
    WORKTREE_PATH="$WORKSPACE_DIR/$REPO"

    if [ ! -d "$REPO_PATH/.git" ]; then
        warning "⚠️  Repo no encontrado: $REPO_PATH (saltando)"
        info "💡 Asegúrate de usar la ruta correcta (ej: libs/marc4j, tools/mi-tool)"
        continue
    fi

    if [ -d "$WORKTREE_PATH" ]; then
        warning "⚠️  El repo ya existe en este workspace: $REPO (saltando)"
        continue
    fi

    info "➕ Añadiendo ${COLOR_CYAN}$REPO${COLOR_RESET} a workspace ${COLOR_BOLD}$WORKSPACE_NAME${COLOR_RESET} (branch: ${COLOR_CYAN}$BRANCH_NAME${COLOR_RESET})"

    # Crear estructura de subdirectorios si es necesario
    WORKTREE_PARENT=$(dirname "$WORKTREE_PATH")
    mkdir -p "$WORKTREE_PARENT"

    cd "$REPO_PATH"

    # Para features, crear branch si no existe
    if [ "$WORKSPACE_NAME" != "master" ] && [ "$WORKSPACE_NAME" != "develop" ]; then
        if ! git rev-parse --verify "$BRANCH_NAME" >/dev/null 2>&1; then
            echo "  ${COLOR_DIM}➕ Creando branch: $BRANCH_NAME${COLOR_RESET}"
            if ! git branch "$BRANCH_NAME" 2>&1; then
                error "  ❌ Error al crear branch $BRANCH_NAME"
                continue
            fi
        fi
    fi

    # Crear worktree
    if git worktree add "$WORKTREE_PATH" "$BRANCH_NAME" 2>&1; then
        success "✅ Repo añadido: $WORKTREE_PATH"
        echo "   Branch: ${COLOR_CYAN}$BRANCH_NAME${COLOR_RESET}"

        # Aislamiento Maven: head por workspace + tail compartido (.mvn/maven.config)
        if setup_maven_isolation "$WORKTREE_PATH" "$WORKSPACE_NAME"; then
            echo "   ${COLOR_DIM}🔒 Aislamiento Maven configurado (.mvn/maven.config)${COLOR_RESET}"
            MAVEN_ISOLATED=$((MAVEN_ISOLATED + 1))
        fi
    else
        error "❌ Error al añadir $REPO"
        info "💡 Verifica que la branch no esté siendo usada por otro worktree"
    fi

    echo ""
done

# Avisar de que los GAV del repo añadido aún no están en el head Maven
if [ "$MAVEN_ISOLATED" -gt 0 ]; then
    maven_warn_if_no_tail_support
    info "💡 Hasta poblar el head Maven, los GAV de los repos añadidos se leen del tail compartido"
    echo "   Puebla el head con: ${COLOR_CYAN}ws mvn $WORKSPACE_NAME install -DskipTests -nsu${COLOR_RESET}"
fi
