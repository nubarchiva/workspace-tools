#!/bin/bash
# Actualiza la branch de trabajo con lo último de develop/master
# Hace merge o rebase de la branch base en todos los repos del workspace

# Inicializacion centralizada
source "$(dirname "${BASH_SOURCE[0]:-$0}")/ws-init.sh"
source "$(dirname "${BASH_SOURCE[0]:-$0}")/ws-git-utils.sh"

# Función de ayuda
show_help() {
    echo "Uso: ws update [workspace] [opciones]"
    echo ""
    echo "Actualiza la branch de trabajo con lo último de develop (o master)."
    echo "Ejecuta merge o rebase en todos los repos del workspace."
    echo ""
    echo "Opciones:"
    echo "  --all, -a          Actualizar TODOS los workspaces"
    echo "  --dry, -d          Modo simulación: muestra qué haría sin ejecutar"
    echo "  --rebase, -r       Usar rebase en lugar de merge"
    echo "  --from, -f BRANCH  Especificar branch base (default: develop o master)"
    echo "  --keep-conflicts   Dejar abierto el merge con conflictos y seguir con el resto"
    echo "  --summary          Uso desatendido: solo merge, una línea por repo"
    echo "  --push             Uso desatendido: publicar la rama del workspace"
    echo ""
    echo "Ejemplos:"
    echo "  ws update                    # merge develop en workspace actual"
    echo "  ws update --rebase           # rebase sobre develop"
    echo "  ws update NUBA-1234          # actualizar workspace específico"
    echo "  ws update -r --from main     # rebase sobre main"
    echo "  ws update --all              # actualizar todos los workspaces"
    echo "  ws update --all --dry        # ver qué actualizaría sin hacerlo"
    echo "  ws update --summary --keep-conflicts   # merge desatendido, conflictos abiertos"
    echo "  ws update --push             # publicar tras compilar"
    echo ""
    echo "Comportamiento:"
    echo "  • Hace fetch del remoto primero y poda las ramas retiradas de origin"
    echo "  • Usa la rama base de origin (develop, main o master); sin ninguna, la local"
    echo "  • Salta repos con cambios sin commitear"
    echo "  • En modo --all: continúa con siguiente workspace si hay conflictos"
    echo ""
    echo "Uso desatendido (--summary, --push):"
    echo "  • Trata todos los repos en la rama del workspace, salvo nuba-management"
    echo "  • Una línea por repo, sin la salida de git: <estado> <repo> <detalle>"
    echo "      up-to-date <repo> <base>"
    echo "      fast-forward <repo> <base> <antes>..<después>"
    echo "      merged <repo> <base> <commit>"
    echo "      conflict <repo> <base> open|aborted <fichero>..."
    echo "      pushed <repo> <rama> <antes>..<después>   (<antes> = new si la rama no existía)"
    echo "      up-to-date <repo> <rama>                  (--push: nada que publicar)"
    echo "      unpublished <repo> <rama> no-own-commits <base>   (--push: no crea en origin"
    echo "                                                una rama sin commits propios)"
    echo "      skipped <repo> merge-in-progress | uncommitted-changes | no-base-branch"
    echo "      skipped <repo> not-on-workspace-branch <rama>"
    echo "      error <repo> remote-unreachable | fetch-failed <causa> | merge-failed <mensaje>"
    echo "      error <repo> offline | diverged | behind-remote | push-failed <causa>"
    echo "  • Código de salida: 0 todo integrado o publicado (unpublished incluido),"
    echo "    1 quedan conflictos, 2 error o algún repo saltado"
    echo "  • --push nunca fuerza: no publica una rama que va por detrás o ha divergido"
    echo "  • --push solo crea la rama en origin si tiene commits que no están en la base;"
    echo "    la rama ya publicada se publica siempre"
}

# Opciones
USE_REBASE=false
UPDATE_ALL=false
DRY_RUN=false
WORKSPACE_PATTERN=""
BASE_BRANCH=""
KEEP_CONFLICTS=false
SUMMARY=false
PUSH=false

# Códigos de salida del uso desatendido: el de cada repo, y el peor manda
EXIT_INTEGRATED=0
EXIT_CONFLICTS=1
EXIT_ERROR=2

# Parsear argumentos
while [[ $# -gt 0 ]]; do
    case $1 in
        --all|-a)
            UPDATE_ALL=true
            shift
            ;;
        --dry|-d)
            DRY_RUN=true
            shift
            ;;
        --rebase|-r)
            USE_REBASE=true
            shift
            ;;
        --from|-f)
            BASE_BRANCH="$2"
            shift 2
            ;;
        --keep-conflicts)
            KEEP_CONFLICTS=true
            shift
            ;;
        --summary)
            SUMMARY=true
            shift
            ;;
        --push)
            PUSH=true
            shift
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            if [ -z "$WORKSPACE_PATTERN" ]; then
                WORKSPACE_PATTERN="$1"
            fi
            shift
            ;;
    esac
done

# Termina el uso desatendido con un error: mensaje a stderr y código EXIT_ERROR
fail_unattended() {
    error "❌ $*" >&2
    exit "$EXIT_ERROR"
}

# Las opciones del uso desatendido solo hacen merge, sobre un único workspace
if [ "$USE_REBASE" = true ] && { [ "$KEEP_CONFLICTS" = true ] || [ "$SUMMARY" = true ] || [ "$PUSH" = true ]; }; then
    fail_unattended "--rebase no se combina con --keep-conflicts, --summary ni --push"
fi
if { [ "$SUMMARY" = true ] || [ "$PUSH" = true ]; } && { [ "$UPDATE_ALL" = true ] || [ "$DRY_RUN" = true ]; }; then
    fail_unattended "--summary y --push no se combinan con --all ni con --dry"
fi
if [ "$PUSH" = true ] && { [ "$KEEP_CONFLICTS" = true ] || [ -n "$BASE_BRANCH" ]; }; then
    fail_unattended "--push solo publica: no se combina con --keep-conflicts ni con --from"
fi

# Determinar operación
if [ "$USE_REBASE" = true ]; then
    OPERATION="rebase"
    OPERATION_VERB="Rebaseando"
    OPERATION_PAST="rebaseado"
else
    OPERATION="merge"
    OPERATION_VERB="Mergeando"
    OPERATION_PAST="mergeado"
fi

# =============================================================================
# Función para calcular commits pendientes de un repo
# Retorna: número de commits que se mergearían/rebasearían
# =============================================================================
get_pending_commits() {
    local repo_path=$1
    local base_branch=$2

    cd "$repo_path" 2>/dev/null || { echo "0"; return; }

    # Determinar branch base si no se especificó
    local local_base="$base_branch"
    if [ -z "$local_base" ]; then
        if ! local_base=$(git_resolve_base_branch); then
            echo "0"
            return
        fi
    fi

    local current_branch=$(git branch --show-current 2>/dev/null)
    git rev-list --count "$current_branch..$local_base" 2>/dev/null || echo "0"
}

# =============================================================================
# Función para mostrar resumen de un workspace (modo --dry o para --all)
# =============================================================================
show_workspace_summary() {
    local ws_name=$1
    local ws_dir=$2

    # Saltar workspaces de rama de integración
    if is_branch_workspace "$ws_name"; then
        return 1
    fi

    local repos=$(find_repos_in_workspace "$ws_dir")
    if [ -z "$repos" ]; then
        return 1
    fi

    local total_pending=0
    local repos_to_update=""
    local repos_with_changes=""

    # Hacer fetch silencioso primero (solo si hay conectividad)
    if git_is_remote_reachable "$ws_dir"; then
        echo "$repos" | while read -r repo_rel_path; do
            if [ -n "$repo_rel_path" ]; then
                local repo_path="$ws_dir/$repo_rel_path"
                git -C "$repo_path" fetch --prune origin --quiet 2>/dev/null || true
            fi
        done
    fi

    # Analizar cada repo
    while read -r repo_rel_path; do
        if [ -n "$repo_rel_path" ]; then
            local repo_path="$ws_dir/$repo_rel_path"

            # Verificar cambios sin commitear
            if git_has_uncommitted_changes "$repo_path"; then
                repos_with_changes="$repos_with_changes $repo_rel_path"
                continue
            fi

            # Contar commits pendientes
            local pending=$(get_pending_commits "$repo_path" "$BASE_BRANCH")
            if [ "$pending" -gt 0 ]; then
                repos_to_update="$repos_to_update $repo_rel_path:$pending"
                total_pending=$((total_pending + pending))
            fi
        fi
    done <<< "$repos"

    # Si no hay nada que hacer, retornar
    if [ $total_pending -eq 0 ] && [ -z "$repos_with_changes" ]; then
        return 1
    fi

    # Mostrar resumen
    echo "🔹 ${COLOR_CYAN}$ws_name${COLOR_RESET}"

    if [ -n "$repos_to_update" ]; then
        for item in $repos_to_update; do
            local repo="${item%:*}"
            local count="${item#*:}"
            echo "   ${COLOR_GREEN}↓ $repo${COLOR_RESET}: $count commit(s) para $OPERATION"
        done
    fi

    if [ -n "$repos_with_changes" ]; then
        for repo in $repos_with_changes; do
            echo "   ${COLOR_YELLOW}⚠️  $repo${COLOR_RESET}: cambios sin commitear (se saltará)"
        done
    fi

    echo ""
    return 0
}

# =============================================================================
# Función para actualizar un workspace específico
# Retorna: 0 si OK, 1 si hubo conflictos
# =============================================================================
update_single_workspace() {
    local ws_name=$1
    local ws_dir=$2
    local stop_on_conflict=${3:-true}

    local branch_name=$(get_branch_name "$ws_name")

    print_header "Actualizar workspace: $ws_name"

    # Mostrar indicador de modo offline
    if ws_is_offline_mode; then
        echo "${COLOR_YELLOW}[OFFLINE]${COLOR_RESET} ${COLOR_DIM}Datos locales (sin fetch)${COLOR_RESET}"
    fi
    echo ""
    echo "Workspace: ${COLOR_CYAN}$ws_name${COLOR_RESET}"
    echo "Branch:    ${COLOR_CYAN}$branch_name${COLOR_RESET}"
    echo "Operación: ${COLOR_BOLD}$OPERATION${COLOR_RESET}"
    echo ""

    local repos=$(find_repos_in_workspace "$ws_dir")

    if [ -z "$repos" ]; then
        warning "No hay repos en este workspace"
        return 0
    fi

    # Contadores
    local updated=0
    local skipped=0
    local already_updated=0
    local conflicts=0

    # Procesar cada repo
    while read -r repo_rel_path; do
        if [ -n "$repo_rel_path" ]; then
            local repo_path="$ws_dir/$repo_rel_path"

            print_separator_with_title "${COLOR_CYAN}$repo_rel_path${COLOR_RESET}"

            cd "$repo_path" || continue

            # Verificar cambios sin commitear
            if git_has_uncommitted_changes "$repo_path"; then
                warning "⏭️  Saltado (cambios sin commitear)"
                ((skipped++))
                echo ""
                continue
            fi

            # Hacer fetch si hay conectividad
            if git_is_remote_reachable "$repo_path"; then
                echo "   ${COLOR_DIM}Fetching...${COLOR_RESET}"
                git fetch --prune origin --quiet 2>/dev/null || true
            fi

            # Determinar branch base para este repo
            local local_base="$BASE_BRANCH"
            if [ -z "$local_base" ]; then
                if ! local_base=$(git_resolve_base_branch); then
                    warning "⏭️  Saltado (no se encontró branch base)"
                    ((skipped++))
                    echo ""
                    continue
                fi
            fi

            # Verificar si hay algo que actualizar
            local current_branch=$(git branch --show-current)
            local behind=$(git rev-list --count "$current_branch..$local_base" 2>/dev/null || echo "0")

            if [ "$behind" -eq 0 ]; then
                success "✓ Ya actualizado con ${local_base#origin/}"
                ((already_updated++))
                echo ""
                continue
            fi

            echo "   ${COLOR_DIM}$OPERATION_VERB $behind commit(s) de ${local_base#origin/}...${COLOR_RESET}"

            # Ejecutar merge o rebase
            if [ "$USE_REBASE" = true ]; then
                if git rebase "$local_base" 2>&1; then
                    success "✅ Rebaseado correctamente"
                    ((updated++))
                else
                    error "❌ Conflictos en rebase"
                    echo ""
                    echo "   Para resolver:"
                    echo "   ${COLOR_DIM}cd $repo_path${COLOR_RESET}"
                    echo "   ${COLOR_DIM}# resolver conflictos${COLOR_RESET}"
                    echo "   ${COLOR_DIM}git rebase --continue${COLOR_RESET}"
                    echo ""
                    git rebase --abort 2>/dev/null || true
                    ((conflicts++))

                    if [ "$stop_on_conflict" = true ]; then
                        echo ""
                        error "❌ Actualización detenida por conflictos"
                        return 1
                    fi
                fi
            else
                if git merge "$local_base" --no-edit 2>&1; then
                    success "✅ Mergeado correctamente"
                    ((updated++))
                else
                    error "❌ Conflictos en merge"
                    echo ""
                    echo "   Para resolver:"
                    echo "   ${COLOR_DIM}cd $repo_path${COLOR_RESET}"
                    echo "   ${COLOR_DIM}# resolver conflictos${COLOR_RESET}"
                    echo "   ${COLOR_DIM}git add . && git commit${COLOR_RESET}"
                    echo ""
                    if [ "$KEEP_CONFLICTS" = true ]; then
                        warning "   Merge abierto con conflictos (--keep-conflicts)"
                    else
                        git merge --abort 2>/dev/null || true
                    fi
                    ((conflicts++))

                    if [ "$stop_on_conflict" = true ]; then
                        echo ""
                        error "❌ Actualización detenida por conflictos"
                        return 1
                    fi
                fi
            fi
            echo ""
        fi
    done <<< "$repos"

    # Resumen
    echo ""
    if [ "$conflicts" -gt 0 ]; then
        warning "⚠️  $updated $OPERATION_PAST, $already_updated ya actualizados, $skipped saltados, $conflicts con conflictos"
        return 1
    else
        success "✅ Workspace actualizado ($updated $OPERATION_PAST, $already_updated ya actualizados, $skipped saltados)"
        return 0
    fi
}


# =============================================================================
# Uso desatendido (--summary y --push)
#
# Cada repo imprime una línea, <estado> <repo> <detalle>, y retorna
# EXIT_INTEGRATED, EXIT_CONFLICTS o EXIT_ERROR. La salida de git no se muestra.
# =============================================================================

# Determina el workspace sin preguntar: el nombre exacto o la única coincidencia
# Define WORKSPACE_NAME y WORKSPACE_DIR; termina con EXIT_ERROR si no lo determina
resolve_unattended_workspace() {
    local pattern=$1
    local matches

    if [ -z "$pattern" ]; then
        pattern=$(detect_current_workspace 2>/dev/null)
        [ -n "$pattern" ] || fail_unattended "No se especificó workspace y no se pudo detectar automáticamente"
    fi

    if [ -d "$WORKSPACES_DIR/$pattern" ]; then
        WORKSPACE_NAME=$pattern
    else
        matches=$(matching_workspaces "$pattern" "$WORKSPACES_DIR")
        case $(printf '%s' "$matches" | grep -c .) in
            0) fail_unattended "No se encontró ningún workspace que coincida con: '$pattern'" ;;
            1) WORKSPACE_NAME=$matches ;;
            *) fail_unattended "Varios workspaces coinciden con '$pattern':" $matches ;;
        esac
    fi

    if is_branch_workspace "$WORKSPACE_NAME"; then
        fail_unattended "No tiene sentido actualizar $WORKSPACE_NAME con sí mismo"
    fi
    WORKSPACE_DIR="$WORKSPACES_DIR/$WORKSPACE_NAME"
}

# Repos que siguen la rama del workspace: nuba-management va en su propia rama
workspace_branch_repos() {
    find_repos_in_workspace "$1" | grep -vxF "$MANAGEMENT_DIR_NAME"
}

# Trae origin, con poda de las ramas retiradas, antes de comparar; en modo
# offline se compara con lo local
# Retorna 1 y deja el motivo en FETCH_FAILURE si no puede
fetch_origin() {
    local repo_path=$1
    local output

    FETCH_FAILURE=""
    ws_is_offline_mode && return 0

    if ! git_is_remote_reachable "$repo_path"; then
        FETCH_FAILURE="remote-unreachable"
        return 1
    fi
    if ! output=$(git -C "$repo_path" fetch --prune origin --quiet 2>&1); then
        FETCH_FAILURE="fetch-failed $(git_error_cause "$output")"
        return 1
    fi
}

# Comprobaciones comunes antes de tocar un repo: imprime su línea si lo salta
# Uso: skip_repo_if_not_ready <repo> <repo_path> <branch>
# Retorna: 0 si lo salta, 1 si se puede seguir
skip_repo_if_not_ready() {
    local repo=$1 repo_path=$2 branch=$3
    local current

    if git_has_merge_in_progress "$repo_path"; then
        echo "skipped $repo merge-in-progress"
        return 0
    fi

    current=$(git -C "$repo_path" branch --show-current)
    if [ "$current" != "$branch" ]; then
        echo "skipped $repo not-on-workspace-branch ${current:-HEAD}"
        return 0
    fi

    return 1
}

# Mergea la rama base en un repo e imprime su línea del resumen
# Uso: summarize_repo_update <repo> <repo_path> <branch>
summarize_repo_update() {
    local repo=$1 repo_path=$2 branch=$3
    local base before output conflicted state

    skip_repo_if_not_ready "$repo" "$repo_path" "$branch" && return "$EXIT_ERROR"

    if git_has_uncommitted_changes "$repo_path"; then
        echo "skipped $repo uncommitted-changes"
        return "$EXIT_ERROR"
    fi

    if ! fetch_origin "$repo_path"; then
        echo "error $repo $FETCH_FAILURE"
        return "$EXIT_ERROR"
    fi

    base=$BASE_BRANCH
    if [ -z "$base" ]; then
        base=$(git_resolve_base_branch "$repo_path")
    fi
    if [ -z "$base" ] || ! git -C "$repo_path" rev-parse -q --verify "$base^{commit}" >/dev/null; then
        echo "skipped $repo no-base-branch"
        return "$EXIT_ERROR"
    fi

    if [ "$(git -C "$repo_path" rev-list --count "HEAD..$base")" -eq 0 ]; then
        echo "up-to-date $repo $base"
        return "$EXIT_INTEGRATED"
    fi

    before=$(git -C "$repo_path" rev-parse --short HEAD)
    if output=$(git -C "$repo_path" merge --no-edit "$base" 2>&1); then
        if [ "$(git -C "$repo_path" rev-parse HEAD)" = "$(git -C "$repo_path" rev-parse "$base^{commit}")" ]; then
            echo "fast-forward $repo $base $before..$(git -C "$repo_path" rev-parse --short HEAD)"
        else
            echo "merged $repo $base $(git -C "$repo_path" rev-parse --short HEAD)"
        fi
        return "$EXIT_INTEGRATED"
    fi

    if ! git_has_merge_in_progress "$repo_path"; then
        output=$(printf '%s\n' "$output" | grep -m 1 -E '^(error|fatal):' || printf '%s\n' "$output" | head -n 1)
        echo "error $repo merge-failed $output"
        return "$EXIT_ERROR"
    fi

    conflicted=$(git -C "$repo_path" diff --name-only --diff-filter=U | tr '\n' ' ')
    conflicted=${conflicted% }
    if [ "$KEEP_CONFLICTS" = true ]; then
        state="open"
    else
        git -C "$repo_path" merge --abort >/dev/null 2>&1
        state="aborted"
    fi
    echo "conflict $repo $base $state${conflicted:+ $conflicted}"
    return "$EXIT_CONFLICTS"
}

# Publica la rama del workspace de un repo sin forzar e imprime su línea
# No crea en origin una rama sin commits propios frente a la rama base
# Uso: publish_repo_branch <repo> <repo_path> <branch>
publish_repo_branch() {
    local repo=$1 repo_path=$2 branch=$3
    local remote_sha head_sha base from output

    skip_repo_if_not_ready "$repo" "$repo_path" "$branch" && return "$EXIT_ERROR"

    if ws_is_offline_mode; then
        echo "error $repo offline"
        return "$EXIT_ERROR"
    fi
    if ! fetch_origin "$repo_path"; then
        echo "error $repo $FETCH_FAILURE"
        return "$EXIT_ERROR"
    fi

    remote_sha=$(git -C "$repo_path" ls-remote --exit-code origin "refs/heads/$branch" 2>/dev/null)
    case $? in
        0) remote_sha=${remote_sha%%[[:space:]]*} ;;
        2) remote_sha="" ;;
        *) echo "error $repo remote-unreachable"; return "$EXIT_ERROR" ;;
    esac

    head_sha=$(git -C "$repo_path" rev-parse HEAD)
    if [ "$remote_sha" = "$head_sha" ]; then
        echo "up-to-date $repo $branch"
        return "$EXIT_INTEGRATED"
    fi

    if [ -z "$remote_sha" ]; then
        if ! base=$(git_resolve_base_branch "$repo_path"); then
            echo "skipped $repo no-base-branch"
            return "$EXIT_ERROR"
        fi
        if [ "$(git -C "$repo_path" rev-list --count "$base..HEAD")" -eq 0 ]; then
            echo "unpublished $repo $branch no-own-commits $base"
            return "$EXIT_INTEGRATED"
        fi
        from="new"
    elif git -C "$repo_path" merge-base --is-ancestor "$remote_sha" HEAD 2>/dev/null; then
        from=$(git -C "$repo_path" rev-parse --short "$remote_sha")
    elif git -C "$repo_path" merge-base --is-ancestor HEAD "$remote_sha" 2>/dev/null; then
        echo "error $repo behind-remote"
        return "$EXIT_ERROR"
    else
        echo "error $repo diverged"
        return "$EXIT_ERROR"
    fi

    if ! output=$(git -C "$repo_path" push --quiet origin "HEAD:refs/heads/$branch" 2>&1); then
        echo "error $repo push-failed $(git_error_cause "$output")"
        return "$EXIT_ERROR"
    fi
    echo "pushed $repo $branch $from..$(git -C "$repo_path" rev-parse --short HEAD)"
    return "$EXIT_INTEGRATED"
}

# Aplica una acción de repo a los repos de la rama del workspace
# Uso: run_unattended <summarize_repo_update|publish_repo_branch> <ws_dir> <branch>
# Retorna: el peor código de los repos
run_unattended() {
    local action=$1 ws_dir=$2 branch=$3
    local worst=$EXIT_INTEGRATED result repo

    # Los repos llegan por el descriptor 3 para que git no consuma su lista por stdin
    while read -r repo <&3; do
        [ -n "$repo" ] || continue
        "$action" "$repo" "$ws_dir/$repo" "$branch"
        result=$?
        [ "$result" -gt "$worst" ] && worst=$result
    done 3<<< "$(workspace_branch_repos "$ws_dir")"

    return "$worst"
}

if [ "$SUMMARY" = true ] || [ "$PUSH" = true ]; then
    resolve_unattended_workspace "$WORKSPACE_PATTERN"
    if [ "$PUSH" = true ]; then
        run_unattended publish_repo_branch "$WORKSPACE_DIR" "$(get_branch_name "$WORKSPACE_NAME")"
    else
        run_unattended summarize_repo_update "$WORKSPACE_DIR" "$(get_branch_name "$WORKSPACE_NAME")"
    fi
    exit $?
fi

# =============================================================================
# MODO --all: Actualizar todos los workspaces
# =============================================================================
if [ "$UPDATE_ALL" = true ]; then

    if [ "$DRY_RUN" = true ]; then
        # Modo simulación
        print_header "Simulación: workspaces a actualizar"
        echo ""
        echo "Operación: ${COLOR_BOLD}$OPERATION${COLOR_RESET}"
        echo ""

        found_any=false
        for ws_dir in "$WORKSPACES_DIR"/*; do
            if [ -d "$ws_dir" ]; then
                ws_name=$(basename "$ws_dir")
                if show_workspace_summary "$ws_name" "$ws_dir"; then
                    found_any=true
                fi
            fi
        done

        if [ "$found_any" = false ]; then
            echo "${COLOR_DIM}Todos los workspaces están actualizados${COLOR_RESET}"
        fi

        echo "${COLOR_DIM}═══════════════════════════════════════════════════${COLOR_RESET}"
        echo "${COLOR_DIM}Ejecuta sin --dry para aplicar los cambios${COLOR_RESET}"
        exit 0
    fi

    # Modo ejecución real
    print_header "Actualizar TODOS los workspaces"
    echo ""
    echo "Operación: ${COLOR_BOLD}$OPERATION${COLOR_RESET}"
    echo ""

    # Contadores globales
    ws_updated=0
    ws_skipped=0
    ws_with_conflicts=0
    ws_already_updated=0

    for ws_dir in "$WORKSPACES_DIR"/*; do
        if [ -d "$ws_dir" ]; then
            ws_name=$(basename "$ws_dir")

            # Saltar workspaces de rama de integración
            if is_branch_workspace "$ws_name"; then
                continue
            fi

            # Verificar si tiene repos
            repos=$(find_repos_in_workspace "$ws_dir")
            if [ -z "$repos" ]; then
                continue
            fi

            echo ""
            if update_single_workspace "$ws_name" "$ws_dir" false; then
                ((ws_updated++))
            else
                ((ws_with_conflicts++))
            fi
        fi
    done

    # Resumen final
    echo ""
    echo "${COLOR_DIM}═══════════════════════════════════════════════════${COLOR_RESET}"
    if [ "$ws_with_conflicts" -gt 0 ]; then
        warning "⚠️  $ws_updated workspaces actualizados, $ws_with_conflicts con conflictos"
    else
        success "✅ $ws_updated workspaces actualizados"
    fi

    exit 0
fi

# =============================================================================
# MODO normal: Actualizar un workspace específico
# =============================================================================

# Auto-detectar workspace si no se especificó
if [ -z "$WORKSPACE_PATTERN" ]; then
    WORKSPACE_PATTERN=$(detect_current_workspace 2>/dev/null || true)
    if [ -z "$WORKSPACE_PATTERN" ]; then
        error "❌ No se especificó workspace y no se pudo detectar automáticamente"
        echo ""
        show_help
        exit 1
    fi
    info "🔍 Workspace detectado: $WORKSPACE_PATTERN"
fi

# Buscar workspace que coincida
WORKSPACE_NAME=$(find_matching_workspace "$WORKSPACE_PATTERN" "$WORKSPACES_DIR")
if [ $? -ne 0 ]; then
    exit 1
fi

WORKSPACE_DIR="$WORKSPACES_DIR/$WORKSPACE_NAME"

if [ ! -d "$WORKSPACE_DIR" ]; then
    die "Workspace no existe: $WORKSPACE_NAME"
fi

# No tiene sentido actualizar una rama de integración
if is_branch_workspace "$WORKSPACE_NAME"; then
    error "❌ No tiene sentido actualizar $WORKSPACE_NAME con sí mismo"
    echo ""
    info "💡 Usa 'ws origins git pull' para sincronizar repos origen"
    exit 1
fi

# Modo --dry para workspace individual
if [ "$DRY_RUN" = true ]; then
    print_header "Simulación: $WORKSPACE_NAME"
    echo ""
    echo "Operación: ${COLOR_BOLD}$OPERATION${COLOR_RESET}"
    echo ""

    if show_workspace_summary "$WORKSPACE_NAME" "$WORKSPACE_DIR"; then
        echo "${COLOR_DIM}Ejecuta sin --dry para aplicar los cambios${COLOR_RESET}"
    else
        echo "${COLOR_DIM}Este workspace está actualizado${COLOR_RESET}"
    fi
    exit 0
fi

# Ejecutar actualización; con --keep-conflicts sigue con el resto de repos
if [ "$KEEP_CONFLICTS" = true ]; then
    update_single_workspace "$WORKSPACE_NAME" "$WORKSPACE_DIR" false
else
    update_single_workspace "$WORKSPACE_NAME" "$WORKSPACE_DIR" true
fi
