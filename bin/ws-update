#!/bin/bash
# Actualiza la branch de trabajo con lo último de develop/master
# Hace merge o rebase de la branch base en todos los repos del workspace

# Inicializacion centralizada
source "$(dirname "${BASH_SOURCE[0]:-$0}")/ws-init.sh"
source "$(dirname "${BASH_SOURCE[0]:-$0}")/ws-git-utils.sh"

# Función de ayuda
show_help() {
    echo "Uso: ws update [workspace] [opciones]"
    echo ""
    echo "Actualiza la branch de trabajo con lo último de develop (o master)."
    echo "Ejecuta merge o rebase en todos los repos del workspace."
    echo ""
    echo "Opciones:"
    echo "  --all, -a          Actualizar TODOS los workspaces"
    echo "  --dry, -d          Modo simulación: muestra qué haría sin ejecutar"
    echo "  --rebase, -r       Usar rebase en lugar de merge"
    echo "  --from, -f BRANCH  Especificar branch base (default: develop o master)"
    echo ""
    echo "Ejemplos:"
    echo "  ws update                    # merge develop en workspace actual"
    echo "  ws update --rebase           # rebase sobre develop"
    echo "  ws update NUBA-1234          # actualizar workspace específico"
    echo "  ws update -r --from main     # rebase sobre main"
    echo "  ws update --all              # actualizar todos los workspaces"
    echo "  ws update --all --dry        # ver qué actualizaría sin hacerlo"
    echo ""
    echo "Comportamiento:"
    echo "  • Hace fetch del remoto primero"
    echo "  • Usa origin/develop si existe, sino develop local"
    echo "  • Fallback a master si no existe develop"
    echo "  • Salta repos con cambios sin commitear"
    echo "  • En modo --all: continúa con siguiente workspace si hay conflictos"
}

# Opciones
USE_REBASE=false
UPDATE_ALL=false
DRY_RUN=false
WORKSPACE_PATTERN=""
BASE_BRANCH=""

# Parsear argumentos
while [[ $# -gt 0 ]]; do
    case $1 in
        --all|-a)
            UPDATE_ALL=true
            shift
            ;;
        --dry|-d)
            DRY_RUN=true
            shift
            ;;
        --rebase|-r)
            USE_REBASE=true
            shift
            ;;
        --from|-f)
            BASE_BRANCH="$2"
            shift 2
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            if [ -z "$WORKSPACE_PATTERN" ]; then
                WORKSPACE_PATTERN="$1"
            fi
            shift
            ;;
    esac
done

# Determinar operación
if [ "$USE_REBASE" = true ]; then
    OPERATION="rebase"
    OPERATION_VERB="Rebaseando"
    OPERATION_PAST="rebaseado"
else
    OPERATION="merge"
    OPERATION_VERB="Mergeando"
    OPERATION_PAST="mergeado"
fi

# =============================================================================
# Función para calcular commits pendientes de un repo
# Retorna: número de commits que se mergearían/rebasearían
# =============================================================================
get_pending_commits() {
    local repo_path=$1
    local base_branch=$2

    cd "$repo_path" 2>/dev/null || { echo "0"; return; }

    # Determinar branch base si no se especificó
    local local_base="$base_branch"
    if [ -z "$local_base" ]; then
        if ! local_base=$(git_resolve_base_branch); then
            echo "0"
            return
        fi
    fi

    local current_branch=$(git branch --show-current 2>/dev/null)
    git rev-list --count "$current_branch..$local_base" 2>/dev/null || echo "0"
}

# =============================================================================
# Función para mostrar resumen de un workspace (modo --dry o para --all)
# =============================================================================
show_workspace_summary() {
    local ws_name=$1
    local ws_dir=$2

    # Saltar workspaces de rama de integración
    if is_branch_workspace "$ws_name"; then
        return 1
    fi

    local repos=$(find_repos_in_workspace "$ws_dir")
    if [ -z "$repos" ]; then
        return 1
    fi

    local total_pending=0
    local repos_to_update=""
    local repos_with_changes=""

    # Hacer fetch silencioso primero (solo si hay conectividad)
    if git_is_remote_reachable "$ws_dir"; then
        echo "$repos" | while read -r repo_rel_path; do
            if [ -n "$repo_rel_path" ]; then
                local repo_path="$ws_dir/$repo_rel_path"
                git -C "$repo_path" fetch origin --quiet 2>/dev/null || true
            fi
        done
    fi

    # Analizar cada repo
    while read -r repo_rel_path; do
        if [ -n "$repo_rel_path" ]; then
            local repo_path="$ws_dir/$repo_rel_path"

            # Verificar cambios sin commitear
            if git_has_uncommitted_changes "$repo_path"; then
                repos_with_changes="$repos_with_changes $repo_rel_path"
                continue
            fi

            # Contar commits pendientes
            local pending=$(get_pending_commits "$repo_path" "$BASE_BRANCH")
            if [ "$pending" -gt 0 ]; then
                repos_to_update="$repos_to_update $repo_rel_path:$pending"
                total_pending=$((total_pending + pending))
            fi
        fi
    done <<< "$repos"

    # Si no hay nada que hacer, retornar
    if [ $total_pending -eq 0 ] && [ -z "$repos_with_changes" ]; then
        return 1
    fi

    # Mostrar resumen
    echo "🔹 ${COLOR_CYAN}$ws_name${COLOR_RESET}"

    if [ -n "$repos_to_update" ]; then
        for item in $repos_to_update; do
            local repo="${item%:*}"
            local count="${item#*:}"
            echo "   ${COLOR_GREEN}↓ $repo${COLOR_RESET}: $count commit(s) para $OPERATION"
        done
    fi

    if [ -n "$repos_with_changes" ]; then
        for repo in $repos_with_changes; do
            echo "   ${COLOR_YELLOW}⚠️  $repo${COLOR_RESET}: cambios sin commitear (se saltará)"
        done
    fi

    echo ""
    return 0
}

# =============================================================================
# Función para actualizar un workspace específico
# Retorna: 0 si OK, 1 si hubo conflictos
# =============================================================================
update_single_workspace() {
    local ws_name=$1
    local ws_dir=$2
    local stop_on_conflict=${3:-true}

    local branch_name=$(get_branch_name "$ws_name")

    print_header "Actualizar workspace: $ws_name"

    # Mostrar indicador de modo offline
    if ws_is_offline_mode; then
        echo "${COLOR_YELLOW}[OFFLINE]${COLOR_RESET} ${COLOR_DIM}Datos locales (sin fetch)${COLOR_RESET}"
    fi
    echo ""
    echo "Workspace: ${COLOR_CYAN}$ws_name${COLOR_RESET}"
    echo "Branch:    ${COLOR_CYAN}$branch_name${COLOR_RESET}"
    echo "Operación: ${COLOR_BOLD}$OPERATION${COLOR_RESET}"
    echo ""

    local repos=$(find_repos_in_workspace "$ws_dir")

    if [ -z "$repos" ]; then
        warning "No hay repos en este workspace"
        return 0
    fi

    # Contadores
    local updated=0
    local skipped=0
    local already_updated=0
    local conflicts=0

    # Procesar cada repo
    while read -r repo_rel_path; do
        if [ -n "$repo_rel_path" ]; then
            local repo_path="$ws_dir/$repo_rel_path"

            print_separator_with_title "${COLOR_CYAN}$repo_rel_path${COLOR_RESET}"

            cd "$repo_path" || continue

            # Verificar cambios sin commitear
            if git_has_uncommitted_changes "$repo_path"; then
                warning "⏭️  Saltado (cambios sin commitear)"
                ((skipped++))
                echo ""
                continue
            fi

            # Hacer fetch si hay conectividad
            if git_is_remote_reachable "$repo_path"; then
                echo "   ${COLOR_DIM}Fetching...${COLOR_RESET}"
                git fetch origin --quiet 2>/dev/null || true
            fi

            # Determinar branch base para este repo
            local local_base="$BASE_BRANCH"
            if [ -z "$local_base" ]; then
                if ! local_base=$(git_resolve_base_branch); then
                    warning "⏭️  Saltado (no se encontró branch base)"
                    ((skipped++))
                    echo ""
                    continue
                fi
            fi

            # Verificar si hay algo que actualizar
            local current_branch=$(git branch --show-current)
            local behind=$(git rev-list --count "$current_branch..$local_base" 2>/dev/null || echo "0")

            if [ "$behind" -eq 0 ]; then
                success "✓ Ya actualizado con ${local_base#origin/}"
                ((already_updated++))
                echo ""
                continue
            fi

            echo "   ${COLOR_DIM}$OPERATION_VERB $behind commit(s) de ${local_base#origin/}...${COLOR_RESET}"

            # Ejecutar merge o rebase
            if [ "$USE_REBASE" = true ]; then
                if git rebase "$local_base" 2>&1; then
                    success "✅ Rebaseado correctamente"
                    ((updated++))
                else
                    error "❌ Conflictos en rebase"
                    echo ""
                    echo "   Para resolver:"
                    echo "   ${COLOR_DIM}cd $repo_path${COLOR_RESET}"
                    echo "   ${COLOR_DIM}# resolver conflictos${COLOR_RESET}"
                    echo "   ${COLOR_DIM}git rebase --continue${COLOR_RESET}"
                    echo ""
                    git rebase --abort 2>/dev/null || true
                    ((conflicts++))

                    if [ "$stop_on_conflict" = true ]; then
                        echo ""
                        error "❌ Actualización detenida por conflictos"
                        return 1
                    fi
                fi
            else
                if git merge "$local_base" --no-edit 2>&1; then
                    success "✅ Mergeado correctamente"
                    ((updated++))
                else
                    error "❌ Conflictos en merge"
                    echo ""
                    echo "   Para resolver:"
                    echo "   ${COLOR_DIM}cd $repo_path${COLOR_RESET}"
                    echo "   ${COLOR_DIM}# resolver conflictos${COLOR_RESET}"
                    echo "   ${COLOR_DIM}git add . && git commit${COLOR_RESET}"
                    echo ""
                    git merge --abort 2>/dev/null || true
                    ((conflicts++))

                    if [ "$stop_on_conflict" = true ]; then
                        echo ""
                        error "❌ Actualización detenida por conflictos"
                        return 1
                    fi
                fi
            fi
            echo ""
        fi
    done <<< "$repos"

    # Resumen
    echo ""
    if [ "$conflicts" -gt 0 ]; then
        warning "⚠️  $updated $OPERATION_PAST, $already_updated ya actualizados, $skipped saltados, $conflicts con conflictos"
        return 1
    else
        success "✅ Workspace actualizado ($updated $OPERATION_PAST, $already_updated ya actualizados, $skipped saltados)"
        return 0
    fi
}

# =============================================================================
# MODO --all: Actualizar todos los workspaces
# =============================================================================
if [ "$UPDATE_ALL" = true ]; then

    if [ "$DRY_RUN" = true ]; then
        # Modo simulación
        print_header "Simulación: workspaces a actualizar"
        echo ""
        echo "Operación: ${COLOR_BOLD}$OPERATION${COLOR_RESET}"
        echo ""

        found_any=false
        for ws_dir in "$WORKSPACES_DIR"/*; do
            if [ -d "$ws_dir" ]; then
                ws_name=$(basename "$ws_dir")
                if show_workspace_summary "$ws_name" "$ws_dir"; then
                    found_any=true
                fi
            fi
        done

        if [ "$found_any" = false ]; then
            echo "${COLOR_DIM}Todos los workspaces están actualizados${COLOR_RESET}"
        fi

        echo "${COLOR_DIM}═══════════════════════════════════════════════════${COLOR_RESET}"
        echo "${COLOR_DIM}Ejecuta sin --dry para aplicar los cambios${COLOR_RESET}"
        exit 0
    fi

    # Modo ejecución real
    print_header "Actualizar TODOS los workspaces"
    echo ""
    echo "Operación: ${COLOR_BOLD}$OPERATION${COLOR_RESET}"
    echo ""

    # Contadores globales
    ws_updated=0
    ws_skipped=0
    ws_with_conflicts=0
    ws_already_updated=0

    for ws_dir in "$WORKSPACES_DIR"/*; do
        if [ -d "$ws_dir" ]; then
            ws_name=$(basename "$ws_dir")

            # Saltar workspaces de rama de integración
            if is_branch_workspace "$ws_name"; then
                continue
            fi

            # Verificar si tiene repos
            repos=$(find_repos_in_workspace "$ws_dir")
            if [ -z "$repos" ]; then
                continue
            fi

            echo ""
            if update_single_workspace "$ws_name" "$ws_dir" false; then
                ((ws_updated++))
            else
                ((ws_with_conflicts++))
            fi
        fi
    done

    # Resumen final
    echo ""
    echo "${COLOR_DIM}═══════════════════════════════════════════════════${COLOR_RESET}"
    if [ "$ws_with_conflicts" -gt 0 ]; then
        warning "⚠️  $ws_updated workspaces actualizados, $ws_with_conflicts con conflictos"
    else
        success "✅ $ws_updated workspaces actualizados"
    fi

    exit 0
fi

# =============================================================================
# MODO normal: Actualizar un workspace específico
# =============================================================================

# Auto-detectar workspace si no se especificó
if [ -z "$WORKSPACE_PATTERN" ]; then
    WORKSPACE_PATTERN=$(detect_current_workspace 2>/dev/null || true)
    if [ -z "$WORKSPACE_PATTERN" ]; then
        error "❌ No se especificó workspace y no se pudo detectar automáticamente"
        echo ""
        show_help
        exit 1
    fi
    info "🔍 Workspace detectado: $WORKSPACE_PATTERN"
fi

# Buscar workspace que coincida
WORKSPACE_NAME=$(find_matching_workspace "$WORKSPACE_PATTERN" "$WORKSPACES_DIR")
if [ $? -ne 0 ]; then
    exit 1
fi

WORKSPACE_DIR="$WORKSPACES_DIR/$WORKSPACE_NAME"

if [ ! -d "$WORKSPACE_DIR" ]; then
    die "Workspace no existe: $WORKSPACE_NAME"
fi

# No tiene sentido actualizar una rama de integración
if is_branch_workspace "$WORKSPACE_NAME"; then
    error "❌ No tiene sentido actualizar $WORKSPACE_NAME con sí mismo"
    echo ""
    info "💡 Usa 'ws origins git pull' para sincronizar repos origen"
    exit 1
fi

# Modo --dry para workspace individual
if [ "$DRY_RUN" = true ]; then
    print_header "Simulación: $WORKSPACE_NAME"
    echo ""
    echo "Operación: ${COLOR_BOLD}$OPERATION${COLOR_RESET}"
    echo ""

    if show_workspace_summary "$WORKSPACE_NAME" "$WORKSPACE_DIR"; then
        echo "${COLOR_DIM}Ejecuta sin --dry para aplicar los cambios${COLOR_RESET}"
    else
        echo "${COLOR_DIM}Este workspace está actualizado${COLOR_RESET}"
    fi
    exit 0
fi

# Ejecutar actualización
update_single_workspace "$WORKSPACE_NAME" "$WORKSPACE_DIR" true
