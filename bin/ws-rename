#!/bin/bash
# Renombra un workspace (directorio, branches, worktrees, aislamiento Maven y .claude/CLAUDE.md)

# Inicializacion centralizada
source "$(dirname "${BASH_SOURCE[0]:-$0}")/ws-init.sh"

# =============================================================================
# Variables globales
# =============================================================================

# NOTA: Los repos están directamente en WORKSPACE_ROOT, no en un subdirectorio /repos
REPOS_DIR="$WORKSPACE_ROOT"
OLD_NAME="$1"
NEW_NAME="$2"

# Arrays para resultados de verificación
declare -a uncommitted_repos
declare -a unpushed_repos
declare -a upstream_repos
has_uncommitted=0
has_unpushed=0
has_upstream=0

# =============================================================================
# Funciones de ayuda y validación
# =============================================================================

show_help() {
    echo "Uso: ws rename <nombre-actual> <nombre-nuevo>"
    echo ""
    echo "Renombra un workspace (directorio, branches locales, referencias de worktrees,"
    echo "aislamiento Maven y .claude/CLAUDE.md)."
    echo ""
    echo "Verificaciones de seguridad:"
    echo "  • BLOQUEA si hay cambios sin commitear"
    echo "  • ADVIERTE si hay commits sin pushear"
    echo "  • ADVIERTE si hay branches con tracking remoto"
    echo ""
    echo "Ejemplos:"
    echo "  ws rename feature-123 feature-456"
    echo "  ws rename old-name new-name"
    echo ""
    echo "IMPORTANTE:"
    echo "  • Tus commits locales NO se perderán"
    echo "  • Necesitarás reconfigurar branches remotas después"
    echo "  • Si trabajas en equipo, coordina el cambio"
}

validate_arguments() {
    if [ -z "$OLD_NAME" ] || [ -z "$NEW_NAME" ]; then
        error "❌ Error: debes especificar nombre actual y nombre nuevo"
        echo ""
        show_help
        exit 1
    fi
}

validate_workspaces() {
    # Verificar que el workspace actual existe
    OLD_DIR="$WORKSPACES_DIR/$OLD_NAME"
    if [ ! -d "$OLD_DIR" ]; then
        error "❌ Error: workspace '$OLD_NAME' no existe"
        echo ""
        echo "Workspaces disponibles:"
        if [ -d "$WORKSPACES_DIR" ]; then
            for ws_dir in "$WORKSPACES_DIR"/*; do
                if [ -d "$ws_dir" ]; then
                    echo "  • ${COLOR_CYAN}$(basename "$ws_dir")${COLOR_RESET}"
                fi
            done
        fi
        exit 1
    fi

    # Verificar que el nuevo nombre no existe
    NEW_DIR="$WORKSPACES_DIR/$NEW_NAME"
    if [ -d "$NEW_DIR" ]; then
        die "Error: workspace '$NEW_NAME' ya existe"
    fi
}

# =============================================================================
# Funciones de verificación de estado
# =============================================================================

# Verifica el estado de todos los repos y llena los arrays globales
check_repos_status() {
    local workspace_dir="$1"
    local repos="$2"

    # Usar archivo temporal para capturar resultados del subshell
    local temp_file
    temp_file=$(mktemp)
    trap "rm -f $temp_file" RETURN

    echo "$repos" | while IFS= read -r repo_rel_path; do
        [ -z "$repo_rel_path" ] && continue

        local repo_path="$workspace_dir/$repo_rel_path"
        [ ! -d "$repo_path" ] && continue

        # Usar git_repo_status del módulo ws-git-utils.sh
        local status
        status=$(git_repo_status "$repo_path")

        # Parsear resultado: "uncommitted:unpushed:has_upstream:branch:upstream"
        IFS=':' read -r uncommitted unpushed repo_has_upstream branch upstream_branch <<< "$status"

        # Cambios sin commitear
        if [ "$uncommitted" -gt 0 ]; then
            echo "UNCOMMITTED:$repo_rel_path:$uncommitted"
        fi

        # Commits sin pushear
        if [ "$unpushed" -gt 0 ]; then
            echo "UNPUSHED:$repo_rel_path:$unpushed"
        fi

        # Tiene upstream
        if [ "$repo_has_upstream" -eq 1 ]; then
            echo "UPSTREAM:$repo_rel_path:$upstream_branch"
        fi
    done > "$temp_file"

    # Procesar resultados
    while IFS=: read -r type repo_path data; do
        case "$type" in
            UNCOMMITTED)
                has_uncommitted=1
                uncommitted_repos+=("$repo_path ($data archivos)")
                ;;
            UPSTREAM)
                has_upstream=1
                upstream_repos+=("$repo_path → $data")
                ;;
            UNPUSHED)
                has_unpushed=1
                unpushed_repos+=("$repo_path ($data commits)")
                ;;
        esac
    done < "$temp_file"
}

# =============================================================================
# Funciones de verificación y advertencia
# =============================================================================

block_if_uncommitted() {
    [ $has_uncommitted -eq 0 ] && return 0

    echo ""
    error "❌ ERROR: No se puede renombrar el workspace"
    echo ""
    echo "Hay cambios sin commitear en:"
    for repo_info in "${uncommitted_repos[@]}"; do
        echo "  • ${COLOR_YELLOW}$repo_info${COLOR_RESET}"
    done
    echo ""
    warning "⚠️  CONSECUENCIA: Renombrar rompería las referencias de Git."
    echo "   Aunque NO perderías los cambios, quedarían en un estado inconsistente."
    echo ""
    success "✅ SOLUCIÓN antes de renombrar:"
    echo ""
    echo "   ${COLOR_BOLD}Opción 1 - Commitear cambios:${COLOR_RESET}"
    echo "     cd $OLD_DIR/<repo>"
    echo "     git add ."
    echo "     git commit -m \"tu mensaje\""
    echo ""
    echo "   ${COLOR_BOLD}Opción 2 - Guardar temporalmente:${COLOR_RESET}"
    echo "     cd $OLD_DIR/<repo>"
    echo "     git stash save \"cambios antes de renombrar workspace\""
    echo ""
    error "Renombrado CANCELADO por seguridad."
    exit 1
}

warn_unpushed_commits() {
    [ $has_unpushed -eq 0 ] && return 0

    echo ""
    warning "⚠️  ADVERTENCIA: Commits locales sin pushear"
    echo ""
    for repo_info in "${unpushed_repos[@]}"; do
        echo "  • ${COLOR_CYAN}$repo_info${COLOR_RESET}"
    done
    echo ""
    echo "${COLOR_BOLD}📋 QUÉ SIGNIFICA ESTO:${COLOR_RESET}"
    echo "   ${COLOR_GREEN}✅ Tus commits están SEGUROS (guardados localmente)${COLOR_RESET}"
    echo "   ${COLOR_GREEN}✅ NO se perderán con el renombrado${COLOR_RESET}"
    echo "   ${COLOR_GREEN}✅ El renombrado funcionará correctamente${COLOR_RESET}"
    echo ""
    echo "${COLOR_YELLOW}⚠️  PERO DESPUÉS del renombrado:${COLOR_RESET}"
    echo "   - Deberás hacer 'git push' manualmente en cada repo"
    echo "   - Si la branch remota se llama \"feature/$OLD_NAME\", tendrás que decidir:"
    echo "     * Crear nueva branch remota: ${COLOR_CYAN}git push -u origin feature/$NEW_NAME${COLOR_RESET}"
    echo "     * Borrar la antigua: ${COLOR_CYAN}git push origin --delete feature/$OLD_NAME${COLOR_RESET}"
    echo ""
    echo "${COLOR_BOLD}💡 RECOMENDACIÓN:${COLOR_RESET}"
    echo "   Si trabajas en equipo, mejor pushea ANTES de renombrar."
    echo ""
    echo -n "¿Entiendes las consecuencias y quieres continuar? [y/N]: "
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo "Renombrado cancelado"
        exit 0
    fi
}

warn_upstream_branches() {
    [ $has_upstream -eq 0 ] && return 0

    echo ""
    warning "⚠️  ADVERTENCIA: Branches pusheadas al remoto"
    echo ""
    for repo_info in "${upstream_repos[@]}"; do
        echo "  • ${COLOR_CYAN}$repo_info${COLOR_RESET}"
    done
    echo ""
    echo "${COLOR_BOLD}📋 QUÉ VA A PASAR:${COLOR_RESET}"
    echo "   1. Branch LOCAL se renombrará: ${COLOR_CYAN}feature/$NEW_NAME${COLOR_RESET} ✅"
    echo "   2. Branch REMOTA seguirá: ${COLOR_YELLOW}origin/feature/$OLD_NAME${COLOR_RESET} ❌"
    echo "   3. Tracking se romperá: Git no sabrá dónde pushear"
    echo ""
    echo "${COLOR_YELLOW}⚠️  CONSECUENCIAS:${COLOR_RESET}"
    echo "   - 'git push' dará error hasta que reconfigures el tracking"
    echo "   - Otros desarrolladores seguirán viendo \"feature/$OLD_NAME\" en GitHub"
    echo ""
    echo "${COLOR_BOLD}✅ SOLUCIÓN (después del renombrado):${COLOR_RESET}"
    echo "   ${COLOR_CYAN}git push -u origin feature/$NEW_NAME${COLOR_RESET}"
    echo "   ${COLOR_CYAN}git push origin --delete feature/$OLD_NAME${COLOR_RESET}"
    echo ""
    echo -n "¿Entiendes las consecuencias? Escribe 'CONTINUAR': "
    read -r response
    if [ "$response" != "CONTINUAR" ]; then
        echo "Renombrado cancelado"
        exit 0
    fi
}

# =============================================================================
# Funciones de resumen y confirmación
# =============================================================================

show_rename_summary() {
    local repos="$1"
    local repo_count
    repo_count=$(echo "$repos" | grep -c .)

    echo ""
    print_header "RESUMEN DE RENOMBRADO"
    echo ""
    echo "Workspace: ${COLOR_CYAN}$OLD_NAME${COLOR_RESET} → ${COLOR_GREEN}$NEW_NAME${COLOR_RESET}"
    echo ""
    echo "Directorio:"
    echo "  $OLD_DIR → $NEW_DIR"
    echo ""
    echo "Repos ($repo_count):"
    echo "$repos" | while IFS= read -r repo_rel_path; do
        [ -z "$repo_rel_path" ] && continue
        local current_branch
        current_branch=$(git_get_current_branch "$OLD_DIR/$repo_rel_path")
        local new_branch
        new_branch=$(renamed_branch "$current_branch")
        if [ -n "$new_branch" ]; then
            echo "  • ${COLOR_CYAN}$repo_rel_path${COLOR_RESET} (branch: $current_branch → $new_branch)"
        else
            echo "  • ${COLOR_CYAN}$repo_rel_path${COLOR_RESET} (branch: $current_branch - sin cambios)"
        fi
    done
    echo ""
    echo "Estado:"
    echo "  ${COLOR_GREEN}✅ Sin cambios pendientes${COLOR_RESET}"
    [ $has_unpushed -eq 1 ] && echo "  ${COLOR_YELLOW}⚠️  Hay commits sin pushear (no se perderán)${COLOR_RESET}"
    [ $has_upstream -eq 1 ] && echo "  ${COLOR_YELLOW}⚠️  Hay branches remotas (requerirán reconfiguración)${COLOR_RESET}"
    echo ""
    echo "${COLOR_BOLD}ACCIONES:${COLOR_RESET}"
    echo "  1. Renombrar directorio"
    echo "  2. Reparar referencias worktrees"
    echo "  3. Renombrar branches locales"
    echo "  4. Actualizar el aislamiento Maven"
    echo "  5. Regenerar .claude/CLAUDE.md"
    echo ""
}

confirm_rename() {
    echo "${COLOR_YELLOW}⚠️  Esta operación NO se puede deshacer automáticamente.${COLOR_RESET}"
    echo ""
    echo "Para confirmar, escribe exactamente: ${COLOR_BOLD}RENOMBRAR${COLOR_RESET}"
    echo -n "Para cancelar, presiona Enter: "
    read -r confirmation

    if [ "$confirmation" != "RENOMBRAR" ]; then
        echo ""
        echo "Renombrado cancelado"
        exit 0
    fi
}

# =============================================================================
# Funciones de ejecución
# =============================================================================

rename_directory() {
    echo "1️⃣  Renombrando directorio..."
    if ! mv "$OLD_DIR" "$NEW_DIR"; then
        die "Error al renombrar directorio"
    fi
    success "   ✅ Directorio renombrado"
}

repair_worktrees() {
    local repos="$1"

    echo ""
    echo "2️⃣  Reparando referencias de worktrees..."
    echo "$repos" | while IFS= read -r repo_rel_path; do
        [ -z "$repo_rel_path" ] && continue

        # Usar ruta relativa completa, no solo basename (para repos en subdirs como libs/marc4j)
        local repo_main="$REPOS_DIR/$repo_rel_path"

        if [ -d "$repo_main/.git" ]; then
            if git -C "$repo_main" worktree repair "$NEW_DIR/$repo_rel_path" >/dev/null 2>&1; then
                success "   ✅ $repo_rel_path"
            else
                warning "   ⚠️  $repo_rel_path (no se pudo reparar)"
            fi
        fi
    done
}

# Rama que corresponde tras el renombrado; vacío si la rama no es del workspace
# Uso: renamed_branch <rama_actual>
renamed_branch() {
    case "$1" in
        "feature/$OLD_NAME")              echo "feature/$NEW_NAME" ;;
        "$(management_branch "$OLD_NAME")") management_branch "$NEW_NAME" ;;
        "$OLD_NAME")                      echo "$NEW_NAME" ;;
    esac
}

rename_branches() {
    local repos="$1"

    echo ""
    echo "3️⃣  Renombrando branches locales..."
    echo "$repos" | while IFS= read -r repo_rel_path; do
        [ -z "$repo_rel_path" ] && continue

        local repo_path="$NEW_DIR/$repo_rel_path"
        local current_branch
        current_branch=$(git_get_current_branch "$repo_path")

        local new_branch
        new_branch=$(renamed_branch "$current_branch")
        if [ -n "$new_branch" ]; then
            if git -C "$repo_path" branch -m "$new_branch" >/dev/null 2>&1; then
                success "   ✅ $repo_rel_path: $current_branch → $new_branch"
            else
                warning "   ⚠️  $repo_rel_path: no se pudo renombrar branch"
            fi
        else
            info "   ℹ️  $repo_rel_path: branch '$current_branch' sin cambios"
        fi
    done
}

# Mueve el repositorio Maven del workspace al nombre nuevo y apunta a él el
# .mvn/maven.config de cada repo. Si ya existe uno con el nombre nuevo, lo
# conserva y deja el anterior donde estaba.
update_maven_isolation() {
    local repos="$1"

    maven_isolation_enabled || return 0

    echo ""
    echo "4️⃣  Actualizando el aislamiento Maven..."

    local old_head new_head
    old_head=$(maven_head_dir "$OLD_NAME")
    new_head=$(maven_head_dir "$NEW_NAME")
    if [ -d "$old_head" ]; then
        if [ -e "$new_head" ]; then
            warning "   ⚠️  Ya existe $new_head: se usa ese y $old_head queda sin workspace"
        elif mv "$old_head" "$new_head"; then
            success "   ✅ Repositorio Maven: $old_head → $new_head"
        else
            warning "   ⚠️  No se pudo mover $old_head"
        fi
    fi

    echo "$repos" | while IFS= read -r repo_rel_path; do
        [ -z "$repo_rel_path" ] && continue
        if setup_maven_isolation "$NEW_DIR/$repo_rel_path" "$NEW_NAME"; then
            success "   ✅ $repo_rel_path: .mvn/maven.config"
        fi
    done
}

regenerate_claude_md() {
    [ -f "$NEW_DIR/.claude/CLAUDE.md" ] || return 0

    echo ""
    echo "5️⃣  Regenerando .claude/CLAUDE.md..."
    _generate_claude_md "$NEW_DIR" "$NEW_NAME" "${CONFIG_REFERENCE_DIR:-$WORKSPACE_ROOT}"
    success "   ✅ .claude/CLAUDE.md"
}

show_post_rename_reminders() {
    [ $has_unpushed -eq 0 ] && [ $has_upstream -eq 0 ] && return

    echo ""
    warning "📋 RECORDATORIOS:"
    if [ $has_unpushed -eq 1 ]; then
        echo ""
        echo "   ${COLOR_BOLD}Pushear commits locales:${COLOR_RESET}"
        echo "      cd $NEW_DIR/<repo> && git push"
    fi
    if [ $has_upstream -eq 1 ]; then
        echo ""
        echo "   ${COLOR_BOLD}Reconfigurar branches remotas:${COLOR_RESET}"
        echo "      git push -u origin feature/$NEW_NAME"
        echo "      git push origin --delete feature/$OLD_NAME"
    fi
}

# =============================================================================
# Flujo principal
# =============================================================================

main() {
    validate_arguments
    validate_workspaces

    # Encontrar repos
    local repos
    repos=$(find_repos_in_workspace "$OLD_DIR")

    # Workspace vacío: renombrado simple
    if [ -z "$repos" ]; then
        warning "⚠️  Workspace '$OLD_NAME' no tiene repos"
        echo -n "¿Renombrar workspace vacío? [y/N]: "
        read -r response
        if [[ ! "$response" =~ ^[Yy]$ ]]; then
            echo "Renombrado cancelado"
            exit 0
        fi
        mv "$OLD_DIR" "$NEW_DIR"
        success "✅ Workspace renombrado: $OLD_NAME → $NEW_NAME"
        exit 0
    fi

    # Verificar estado de repos
    echo ""
    info "🔍 Verificando estado de repos..."
    check_repos_status "$OLD_DIR" "$repos"

    # Verificaciones de seguridad
    block_if_uncommitted
    success "✅ No hay cambios sin commitear"
    warn_unpushed_commits
    warn_upstream_branches

    # Mostrar resumen y pedir confirmación
    show_rename_summary "$repos"
    confirm_rename

    # Ejecutar renombrado
    echo ""
    info "🔄 Renombrando workspace..."
    echo ""

    rename_directory
    repair_worktrees "$repos"
    rename_branches "$repos"
    update_maven_isolation "$repos"
    regenerate_claude_md

    # Éxito
    echo ""
    print_header "✅ Workspace renombrado: $OLD_NAME → $NEW_NAME"

    show_post_rename_reminders

    echo ""
    info "📁 Nueva ubicación: ${COLOR_CYAN}$NEW_DIR${COLOR_RESET}"
    echo ""
}

main
