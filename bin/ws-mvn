#!/bin/bash
# Ejecuta comandos Maven en todos los proyectos de un workspace

# Inicializacion centralizada
source "$(dirname "${BASH_SOURCE[0]:-$0}")/ws-init.sh"

# Determinar workspace y argumentos
# Prioridad: 1) Workspace explícito si $1 coincide con uno existente
#            2) Auto-detección si estamos dentro de un workspace
#            3) Modo tradicional (primer arg es workspace)
WORKSPACE_PATTERN=""
MVN_ARGS=""

if [[ -n "$1" ]]; then
    if is_workspace_pattern "$1"; then
        # Primer argumento coincide con workspace → modo explícito
        WORKSPACE_PATTERN="$1"
        shift
        MVN_ARGS="$@"
    else
        # Primer argumento NO es workspace → intentar auto-detección
        DETECTED_WORKSPACE=$(detect_current_workspace 2>/dev/null || true)
        if [[ -n "$DETECTED_WORKSPACE" ]]; then
            # Auto-detectado, todos los args son para Maven
            WORKSPACE_PATTERN="$DETECTED_WORKSPACE"
            MVN_ARGS="$@"
        else
            # No auto-detectado, asumir modo tradicional
            WORKSPACE_PATTERN="$1"
            shift
            MVN_ARGS="$@"
        fi
    fi
else
    # Sin argumentos, intentar auto-detección
    DETECTED_WORKSPACE=$(detect_current_workspace 2>/dev/null || true)
    if [[ -n "$DETECTED_WORKSPACE" ]]; then
        WORKSPACE_PATTERN="$DETECTED_WORKSPACE"
        MVN_ARGS="$@"
    fi
fi

# Función de ayuda
show_help() {
    echo "Uso: ws mvn <nombre|patrón> <argumentos-maven>"
    echo ""
    echo "Ejecuta comandos Maven en todos los proyectos de un workspace."
    echo ""
    echo "💡 Puedes usar coincidencia parcial para el nombre del workspace"
    echo ""
    echo "Ejemplos:"
    echo "  ws mvn nuba-8400 clean install"
    echo "  ws mvn master test"
    echo "  ws mvn fac clean compile     # búsqueda parcial"
    echo ""
    echo "Comportamiento:"
    echo "  • Busca pom.xml en la raíz de cada repo del workspace"
    echo "  • Ejecuta 'mvn <args>' desde la raíz de cada proyecto"
    echo "    (aplica el .mvn/maven.config del repo: aislamiento Maven por workspace)"
    echo "  • Se detiene en el primer error"
    echo "  • Ignora repos sin pom.xml con un mensaje informativo"
    echo ""
    echo "Orden de compilación:"
    echo "  Busca .ws-build-order (primero en workspace, luego en raíz)."
    echo "  Solo compila repos que existen en el workspace."
    echo "  Formato del archivo (una línea por repo):"
    echo "    # Comentarios con #"
    echo "    dga-commons"
    echo "    ks-nuba"
    echo "    modules/diffusion-portal"
}

# Validar argumentos Maven
if [[ -z "$MVN_ARGS" ]]; then
    error "❌ Error: debes especificar argumentos para Maven"
    echo ""
    show_help
    exit 1
fi

# Resolver workspace (usa WORKSPACE_PATTERN, define WORKSPACE_NAME y WORKSPACE_DIR)
resolve_workspace "$WORKSPACE_PATTERN" "ws mvn <workspace> <argumentos-maven>"
BRANCH_NAME="$(get_branch_name "$WORKSPACE_NAME")"

print_header "Ejecutando Maven en workspace"
echo ""
echo "Workspace: ${COLOR_CYAN}$WORKSPACE_NAME${COLOR_RESET}"
echo "Branch:    ${COLOR_CYAN}$BRANCH_NAME${COLOR_RESET}"
echo "Comando:   ${COLOR_BOLD}mvn $MVN_ARGS${COLOR_RESET}"
echo ""

# Determinar orden de compilación
# Prioridad: 1) .ws-build-order en el workspace
#            2) .ws-build-order en WORKSPACE_ROOT
#            3) find_repos_in_workspace (orden por defecto)
BUILD_ORDER_FILE=""
if [ -f "$WORKSPACE_DIR/.ws-build-order" ]; then
    BUILD_ORDER_FILE="$WORKSPACE_DIR/.ws-build-order"
elif [ -f "$WORKSPACE_ROOT/.ws-build-order" ]; then
    BUILD_ORDER_FILE="$WORKSPACE_ROOT/.ws-build-order"
fi

if [ -n "$BUILD_ORDER_FILE" ]; then
    # Usar orden del archivo, pero solo repos que existen en el workspace
    workspace_repos=$(find_repos_in_workspace "$WORKSPACE_DIR")
    repos=""
    while IFS= read -r repo; do
        # Ignorar comentarios y líneas vacías
        [[ "$repo" =~ ^# ]] && continue
        [[ -z "$repo" ]] && continue
        # Solo incluir si existe en el workspace
        if echo "$workspace_repos" | grep -q "^${repo}$"; then
            repos="${repos}${repo}"$'\n'
        fi
    done < "$BUILD_ORDER_FILE"
    repos=$(echo "$repos" | grep -v '^$')
    info "📋 Usando orden de compilación de $(basename "$BUILD_ORDER_FILE")"
    echo ""
else
    repos=$(find_repos_in_workspace "$WORKSPACE_DIR")
fi

if [ -z "$repos" ] || [ "$repos" = "" ]; then
    die "No hay repos en este workspace"
fi

# Contar proyectos Maven
maven_projects=0
skipped_repos=0

# Archivo temporal para almacenar tiempos de ejecución
temp_times=$(mktemp)
trap "rm -f $temp_times" EXIT

# Ejecutar Maven en cada repo que tenga pom.xml
echo "$repos" | while read -r repo_rel_path; do
    if [ -n "$repo_rel_path" ]; then
        repo_path="$WORKSPACE_DIR/$repo_rel_path"
        pom_path="$repo_path/pom.xml"

        if [ -f "$pom_path" ]; then
            ((maven_projects++))
            print_separator_with_title "Ejecutando en: ${COLOR_CYAN}$repo_rel_path${COLOR_RESET}"
            echo ""

            # Capturar tiempo de inicio
            start_time=$(date +%s)

            # Ejecutar Maven desde la raíz del repo: Maven localiza .mvn/maven.config
            # subiendo desde el directorio actual (no desde -f), y ahí vive el
            # aislamiento del repositorio local por workspace
            (cd "$repo_path" && mvn $MVN_ARGS)

            # Verificar el resultado
            exit_code=$?

            # Capturar tiempo de fin
            end_time=$(date +%s)
            elapsed=$((end_time - start_time))

            # Guardar tiempo en archivo temporal
            echo "$repo_rel_path|$elapsed" >> "$temp_times"

            if [ $exit_code -ne 0 ]; then
                echo ""
                error "❌ Error en $repo_rel_path (exit code: $exit_code)"
                error "   Deteniendo ejecución"
                exit $exit_code
            fi

            echo ""
        else
            ((skipped_repos++))
            info "ℹ️  Ignorando $repo_rel_path (no tiene pom.xml)"
        fi
    fi
done

# Capturar el exit code del while loop
exit_code=$?

if [ $exit_code -ne 0 ]; then
    exit $exit_code
fi

echo ""
success "✅ Maven ejecutado correctamente en todos los proyectos"
if [ $skipped_repos -gt 0 ]; then
    echo "   ${COLOR_DIM}($skipped_repos repos ignorados por no tener pom.xml)${COLOR_RESET}"
fi

# Mostrar resumen de tiempos
if [ -f "$temp_times" ] && [ -s "$temp_times" ]; then
    echo ""
    echo "${COLOR_BOLD}═══════════════════════════════════════════════════${COLOR_RESET}"
    echo "${COLOR_BOLD}Resumen de ejecución:${COLOR_RESET}"
    echo "${COLOR_BOLD}═══════════════════════════════════════════════════${COLOR_RESET}"

    total_time=0
    while IFS='|' read -r project time; do
        total_time=$((total_time + time))
        # Formatear nombre del proyecto con puntos para alineación
        printf "  • %-40s ${COLOR_DIM}%5ss${COLOR_RESET}\n" "$project" "$time"
    done < "$temp_times"

    echo "${COLOR_DIM}───────────────────────────────────────────────────${COLOR_RESET}"
    printf "  ${COLOR_BOLD_GREEN}Total: %ss${COLOR_RESET}\n" "$total_time"
fi
