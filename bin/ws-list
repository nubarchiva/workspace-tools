#!/bin/bash
# Lista todos los workspaces activos (opcionalmente filtrados por patrón)

# Inicializacion centralizada
source "$(dirname "${BASH_SOURCE[0]:-$0}")/ws-init.sh"

# Patrón de filtro opcional
FILTER_PATTERN=$1

if [ -n "$FILTER_PATTERN" ]; then
    print_header "WORKSPACES ACTIVOS (filtro: $FILTER_PATTERN)"
else
    print_header "WORKSPACES ACTIVOS"
fi

# Mostrar indicador de modo offline
if ws_is_offline_mode; then
    echo "${COLOR_YELLOW}[OFFLINE]${COLOR_RESET} ${COLOR_DIM}Datos locales (sin fetch)${COLOR_RESET}"
fi
echo ""

# Función para mostrar workspace
show_workspace() {
    local name=$1
    local path=$2
    local branch=$(get_branch_name "$name")

    echo "🔹 ${COLOR_BOLD_CYAN}$name${COLOR_RESET} ${COLOR_DIM}(branch: ${COLOR_CYAN}$branch${COLOR_RESET}${COLOR_DIM})${COLOR_RESET}"

    # Encontrar repos (incluyendo subdirectorios)
    local repos=$(find_repos_in_workspace "$path")
    local repo_count=$(echo "$repos" | grep -v '^$' | wc -l)

    if [ $repo_count -eq 0 ]; then
        echo "   ${COLOR_DIM}📦 Repos: 0${COLOR_RESET}"
        echo ""
        return
    fi

    echo "   ${COLOR_DIM}📦 Repos: $repo_count${COLOR_RESET}"

    # Listar repos con indicador de sincronización
    echo "   📂 Contenido:"
    echo "$repos" | while read -r repo_rel_path; do
        if [ -n "$repo_rel_path" ]; then
            local worktree_path="$path/$repo_rel_path"
            local sync_indicator=""

            # Calcular sincronización (solo para workspaces que no son de rama de integración)
            if ! is_branch_workspace "$name" && [ -d "$worktree_path" ]; then
                local sync_status=$(get_sync_status "$worktree_path")
                # Parsear los 3 valores: unpushed:pending_merge:behind
                local unpushed=$(echo "$sync_status" | cut -d: -f1)
                local pending_merge=$(echo "$sync_status" | cut -d: -f2)
                local behind=$(echo "$sync_status" | cut -d: -f3)

                # Construir indicador con los 3 estados
                # ↑ = commits sin push (amarillo)
                # ← = pusheado, pendiente merge a develop (cyan)
                # ↓ = develop tiene commits nuevos (magenta)
                if [ "$unpushed" -gt 0 ]; then
                    sync_indicator=" ${COLOR_YELLOW}↑$unpushed${COLOR_RESET}"
                fi
                if [ "$pending_merge" -gt 0 ]; then
                    sync_indicator="$sync_indicator ${COLOR_CYAN}←$pending_merge${COLOR_RESET}"
                fi
                if [ "$behind" -gt 0 ]; then
                    sync_indicator="$sync_indicator ${COLOR_MAGENTA}↓$behind${COLOR_RESET}"
                fi
            fi

            echo "      • $repo_rel_path$sync_indicator"
        fi
    done

    # Mostrar repos con cambios sin commitear
    has_uncommitted=false
    echo "$repos" | while read -r repo_rel_path; do
        if [ -n "$repo_rel_path" ]; then
            worktree_path="$path/$repo_rel_path"
            if git_has_uncommitted_changes "$worktree_path"; then
                if [ "$has_uncommitted" = false ]; then
                    echo "   ${COLOR_YELLOW}⚠️  Cambios sin commitear:${COLOR_RESET}"
                    has_uncommitted=true
                fi
                change_count=$(git_count_uncommitted_changes "$worktree_path")
                echo "      ${COLOR_YELLOW}• $repo_rel_path ($change_count archivos)${COLOR_RESET}"
            fi
        fi
    done

    # Mostrar repos con commits pendientes de push
    has_unpushed=false
    echo "$repos" | while read -r repo_rel_path; do
        if [ -n "$repo_rel_path" ]; then
            worktree_path="$path/$repo_rel_path"
            if git_has_unpushed_commits "$worktree_path"; then
                if [ "$has_unpushed" = false ]; then
                    echo "   ${COLOR_YELLOW}📤 Cambios sin push:${COLOR_RESET}"
                    has_unpushed=true
                fi
                unpushed_count=$(git_count_unpushed_commits "$worktree_path")
                if git_has_upstream "$worktree_path"; then
                    echo "      ${COLOR_YELLOW}• $repo_rel_path ($unpushed_count commits)${COLOR_RESET}"
                else
                    echo "      ${COLOR_YELLOW}• $repo_rel_path ($unpushed_count commits sin remoto)${COLOR_RESET}"
                fi
            fi
        fi
    done

    echo ""
}

# Contar workspaces
workspace_count=0
filtered_count=0

# Listar todos los workspaces (ramas de integración y features)
if [ -d "$WORKSPACES_DIR" ]; then
    for workspace_dir in "$WORKSPACES_DIR"/*; do
        if [ -d "$workspace_dir" ]; then
            workspace_name=$(basename "$workspace_dir")
            ((workspace_count++))

            # Si hay filtro, verificar que el nombre coincida
            if [ -n "$FILTER_PATTERN" ]; then
                # Búsqueda parcial case-insensitive
                if [[ ! "$workspace_name" =~ "$FILTER_PATTERN" ]]; then
                    continue  # Saltar este workspace
                fi
            fi

            ((filtered_count++))
            show_workspace "$workspace_name" "$workspace_dir"
        fi
    done
fi

if [ $workspace_count -eq 0 ]; then
    echo "  ${COLOR_DIM}(No hay workspaces activos)${COLOR_RESET}"
    echo ""
    info "💡 Usa 'ws new <nombre> [repos...]' para crear uno"
    echo ""
elif [ -n "$FILTER_PATTERN" ] && [ $filtered_count -eq 0 ]; then
    echo "  ${COLOR_DIM}(No hay workspaces que coincidan con '$FILTER_PATTERN')${COLOR_RESET}"
    echo ""
    echo "${COLOR_DIM}Total de workspaces: $workspace_count${COLOR_RESET}"
    echo ""
else
    echo "${COLOR_DIM}═══════════════════════════════════════════════════${COLOR_RESET}"
    if [ -n "$FILTER_PATTERN" ]; then
        echo "${COLOR_DIM}Mostrando: $filtered_count de $workspace_count workspaces${COLOR_RESET}"
    else
        echo "${COLOR_DIM}Total: $workspace_count workspaces${COLOR_RESET}"
    fi
    echo "${COLOR_DIM}═══════════════════════════════════════════════════${COLOR_RESET}"
    echo ""
    info "💡 Usa 'ws switch <nombre>' para ver detalle de un workspace"
fi
