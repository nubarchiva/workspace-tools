#!/bin/bash
# Limpia un workspace terminado (elimina worktrees pero mantiene branches)
# Soporta repos en subdirectorios

# Inicializacion centralizada
source "$(dirname "${BASH_SOURCE[0]:-$0}")/ws-init.sh"

# Parsear argumentos
FORCE=false
WORKSPACE_PATTERN=""

for arg in "$@"; do
    case $arg in
        --force|-f)
            FORCE=true
            ;;
        *)
            WORKSPACE_PATTERN="$arg"
            ;;
    esac
done

# Función de ayuda
show_help() {
    echo "Uso: ws clean [--force|-f] [nombre|patrón]"
    echo ""
    echo "Elimina los worktrees de un workspace pero mantiene las branches."
    echo ""
    echo "Opciones:"
    echo "  --force, -f    Omitir confirmación"
    echo ""
    echo "💡 Puedes usar coincidencia parcial para el nombre del workspace"
    echo ""
    echo "Ejemplos:"
    echo "  ws clean master"
    echo "  ws clean develop"
    echo "  ws clean nuba-8400"
    echo "  ws clean fac                     # búsqueda parcial"
    echo "  ws clean -f feature-123          # sin confirmación"
    echo "  ws rm --force test               # alias con force"
    echo ""
    echo "⚠️  Este comando:"
    echo "  • Elimina los directorios de worktree"
    echo "  • Elimina el repositorio Maven aislado del workspace (~/.m2/wt/<nombre>/)"
    echo "  • Mantiene las branches en los repos principales"
    echo "  • NO elimina commits ni cambios commiteados"
}

if [ -z "$WORKSPACE_PATTERN" ]; then
    show_help
    exit 1
fi

# Buscar workspace que coincida con el patrón
WORKSPACE_NAME=$(find_matching_workspace "$WORKSPACE_PATTERN" "$WORKSPACES_DIR")
if [ $? -ne 0 ]; then
    exit 1
fi

# Determinar directorio del workspace
WORKSPACE_DIR="$WORKSPACES_DIR/$WORKSPACE_NAME"
BRANCH_NAME="$(get_branch_name "$WORKSPACE_NAME")"

if [ ! -d "$WORKSPACE_DIR" ]; then
    die "Workspace no existe: $WORKSPACE_NAME"
fi

# Mostrar qué se va a eliminar
warning "⚠️  Vas a limpiar el workspace: ${COLOR_BOLD}$WORKSPACE_NAME${COLOR_RESET} (branch: ${COLOR_CYAN}$BRANCH_NAME${COLOR_RESET})"
echo ""
echo "Repos afectados:"

repos=$(find_repos_in_workspace "$WORKSPACE_DIR")
has_repos=false
has_uncommitted_changes=false

echo "$repos" | while read -r repo_rel_path; do
    if [ -n "$repo_rel_path" ]; then
        has_repos=true
        worktree_path="$WORKSPACE_DIR/$repo_rel_path"
        echo "  • ${COLOR_CYAN}$repo_rel_path${COLOR_RESET}"

        # Verificar si hay cambios sin commitear
        if git_has_uncommitted_changes "$worktree_path"; then
            warning "    ⚠️  TIENE CAMBIOS SIN COMMITEAR"
            has_uncommitted_changes=true
        fi
    fi
done

if [ -z "$repos" ] || [ "$repos" = "" ]; then
    echo "  ${COLOR_DIM}(No hay repos en este workspace)${COLOR_RESET}"
fi

# Repositorio Maven aislado del workspace (head), si existe
MAVEN_HEAD_DIR="$(maven_head_dir "$WORKSPACE_NAME")"
if [ -d "$MAVEN_HEAD_DIR" ]; then
    head_size=$(du -sh "$MAVEN_HEAD_DIR" 2>/dev/null | cut -f1)
    echo ""
    echo "También se eliminará el repositorio Maven del workspace:"
    echo "  • ${COLOR_CYAN}$MAVEN_HEAD_DIR${COLOR_RESET} ${COLOR_DIM}(${head_size:-?})${COLOR_RESET}"
fi

echo ""
echo "Esto eliminará los worktrees pero mantendrá las branches en los repos principales."
echo ""

if [ "$FORCE" = false ]; then
    read -p "¿Continuar? (s/n) " -n 1 -r
    echo

    if [[ ! $REPLY =~ ^[Ss]$ ]]; then
        error "❌ Cancelado"
        exit 1
    fi
fi

# Eliminar cada worktree
echo ""
info "Limpiando worktrees..."

echo "$repos" | while read -r repo_rel_path; do
    if [ -n "$repo_rel_path" ]; then
        worktree_path="$WORKSPACE_DIR/$repo_rel_path"

        if [ -d "$worktree_path" ]; then
            echo "  ${COLOR_DIM}🗑️  Eliminando worktree: $repo_rel_path${COLOR_RESET}"

            cd "$worktree_path"

            # Obtener el directorio del repo principal
            # Para git worktrees, .git puede ser un archivo o directorio
            if [ -f "$worktree_path/.git" ]; then
                # Es un worktree (archivo .git apunta al repo principal)
                MAIN_REPO=$(grep "gitdir:" "$worktree_path/.git" | cut -d' ' -f2 | sed 's|/\.git/worktrees/.*||')
            else
                # Es el repo principal o un caso especial
                MAIN_REPO=$(git rev-parse --git-common-dir 2>/dev/null | sed 's|/\.git.*||')
            fi

            # Volver al repo principal y eliminar worktree
            if [ -d "$MAIN_REPO" ]; then
                cd "$MAIN_REPO"
                git worktree remove "$worktree_path" --force 2>/dev/null || {
                    # Si falla, intentar eliminar manualmente
                    rm -rf "$worktree_path"
                    git worktree prune
                }
                success "     ✅ Eliminado"
            else
                warning "     ⚠️  No se pudo encontrar repo principal, eliminando directorio"
                rm -rf "$worktree_path"
            fi
        fi
    fi
done

# Eliminar directorio del workspace (y sus subdirectorios vacíos)
WORKSPACE_FULLY_REMOVED=true

if [ -d "$WORKSPACE_DIR" ]; then
    # Eliminar directorios vacíos recursivamente
    find "$WORKSPACE_DIR" -type d -empty -delete 2>/dev/null || true

    # Archivos/directorios que deben ignorarse al determinar si el workspace está vacío
    # Configurable via WS_CLEAN_IGNORE en ~/.wsrc
    # Por defecto:
    # - .idea/, .vscode/, .kiro/, .cursor/: configuración IDE/AI copiada por copy_workspace_config
    # - .playwright-mcp/: configuración de herramientas testing
    # - AI.md, .ai/, docs/: symlinks creados por copy_workspace_config
    # - README.md: puede ser creado automáticamente
    # - .DS_Store: archivo de sistema macOS
    # Nota: .claude NO está por defecto porque puede contener commands/ personalizados
    default_ignore=".idea .vscode .kiro .cursor .playwright-mcp AI.md .ai docs README.md .DS_Store"
    ignore_list="${WS_CLEAN_IGNORE:-$default_ignore}"

    # Convertir a array
    read -ra ignore_patterns <<< "$ignore_list"

    # Contar archivos que NO deben ignorarse
    significant_files=0
    all_files=()
    significant_file_list=()

    # Leer todos los archivos en el directorio
    while IFS= read -r file; do
        [ -n "$file" ] && all_files+=("$file")
    done < <(ls -A "$WORKSPACE_DIR" 2>/dev/null)

    # Contar archivos significativos (que no están en la lista de ignorados)
    for file in "${all_files[@]}"; do
        should_ignore=false
        file_path="$WORKSPACE_DIR/$file"

        # Ignorar enlaces simbólicos (pueden ser repos referenciados sin worktree)
        if [ -L "$file_path" ]; then
            should_ignore=true
        fi

        # Ignorar archivos en la lista de patrones
        if [ "$should_ignore" = false ]; then
            for pattern in "${ignore_patterns[@]}"; do
                if [ "$file" = "$pattern" ]; then
                    should_ignore=true
                    break
                fi
            done
        fi

        if [ "$should_ignore" = false ]; then
            ((significant_files++))
            significant_file_list+=("$file")
        fi
    done

    # Si no hay archivos significativos, eliminar todo el workspace
    if [ $significant_files -eq 0 ]; then
        rm -rf "$WORKSPACE_DIR"
    else
        # Hay archivos del usuario, no eliminar
        WORKSPACE_FULLY_REMOVED=false
    fi
fi

# Eliminar el repositorio Maven aislado del workspace (head): los worktrees
# que lo consumían ya no existen, mantenerlo solo ocupa disco
if [ -n "$WORKSPACE_NAME" ] && [ -d "$MAVEN_HEAD_DIR" ]; then
    rm -rf "$MAVEN_HEAD_DIR"
    success "🧹 Repositorio Maven del workspace eliminado: $MAVEN_HEAD_DIR"
fi

# Mensaje final coherente según el resultado
echo ""
if [ "$WORKSPACE_FULLY_REMOVED" = true ]; then
    success "✅ Workspace eliminado completamente: $WORKSPACE_NAME"
else
    warning "⚠️  Workspace parcialmente limpiado: $WORKSPACE_NAME"
    echo ""
    echo "   El directorio NO se eliminó porque contiene archivos/directorios adicionales:"
    for file in "${significant_file_list[@]}"; do
        echo "      • $file"
    done
    echo ""
    echo "   Ubicación: $WORKSPACE_DIR"
    echo ""
    echo "   Si son worktrees que no se detectaron correctamente, elimínalos manualmente:"
    echo "      rm -rf \"$WORKSPACE_DIR\""
fi

echo ""
info "💡 Las branches se mantienen en los repos principales:"
echo "   Branch: ${COLOR_CYAN}$BRANCH_NAME${COLOR_RESET}"
echo ""
echo "Para eliminar la branch de un repo:"
echo "  ${COLOR_DIM}cd $WORKSPACE_ROOT/<repo> && git branch -d $BRANCH_NAME${COLOR_RESET}"
